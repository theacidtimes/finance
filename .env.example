# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Chave service_role — SOMENTE no servidor (rotas de API). Usada para criar/apagar
# usuários (admin). NUNCA usar prefixo NEXT_PUBLIC_ nem importar no client.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Anthropic (Claude) — SOMENTE no servidor. Usada para extrair o pedido de
# orçamento do cliente (PDF ou texto de e-mail) em campos estruturados.
# NUNCA usar prefixo NEXT_PUBLIC_ nem importar no client.
ANTHROPIC_API_KEY=coloque-a-anthropic-api-key-aqui
