# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Chave service_role — SOMENTE no servidor (rotas de API). Usada para criar/apagar
# usuários (admin). NUNCA usar prefixo NEXT_PUBLIC_ nem importar no client.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui
